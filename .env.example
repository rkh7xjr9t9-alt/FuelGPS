# ──────────────────────────────────────────────────────────────
#  Fuel GPS — Environment Variables
#  Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (production / Docker) ──────────────────────────
# Used by the database container
POSTGRES_DB=fueldgps
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change_me_strong_password

# Full connection URL for the app container
DATABASE_URL=postgres://fuel:change_me_strong_password@db:5432/fueldgps

# ── JWT ────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string

# ── Application ────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Data seeding ──────────────────────────────────────────────
# Set to "false" in production once you have real data
SEED_DB=true

# ── OpenStreetMap Overpass fetch ──────────────────────────────
# Set to "false" to skip the live OSM fetch on startup
FETCH_OSM=true

# ── Nginx port mapping ────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
